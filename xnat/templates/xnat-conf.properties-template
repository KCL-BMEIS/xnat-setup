datasource.driver=org.postgresql.Driver
datasource.url=jdbc:postgresql://xnat-db/xnat
datasource.username=@PG_USR@
datasource.password=@PG_PWD@

# NOT 95
# org.hibernate.dialect.PostgreSQL95Dialect if hibernate 5.x, else do not specify version (PostgreSQLDialect).
# Original: hibernate.dialect=org.hibernate.dialect.PostgreSQL9Dialect
# hibernate.dialect=org.hibernate.dialect.PostgreSQL9Dialect
hibernate.dialect=org.hibernate.dialect.PostgreSQL9Dialect
hibernate.hbm2ddl.auto=update
hibernate.show_sql=false
hibernate.cache.use_second_level_cache=true
hibernate.cache.use_query_cache=true


# default  Hikari. Can use DBCP2 Basic Data Source or HikariCP
# https://wiki.xnat.org/documentation/configuring-jdbc-connection-pools
# default from 1.9 and above, do not need to mention: datasource.class=com.zaxxer.hikari.HikariDataSource
# spring.datasource.type=com.zaxxer.hikari.HikariDataSource
# spring.datasource.hikari.data-source-properties.cachePrepStmts=true

# added
spring.http.multipart.max-file-size=1073741824
spring.http.multipart.max-request-size=1073741824
# Ensures large files are written to disk instead of being held in memory, preventing OutOfMemoryError
# spring.servlet.multipart.file-size-threshold=2MB
