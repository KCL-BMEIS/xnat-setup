FROM nginx:stable-alpine
ARG TIMEZONE
#takes timezone from host in build.sh

# needed for apk
USER root
ENV TZ=$TIMEZONE

# logrotate to update nginx log files, openrc as cron required and needs openrc to start it
# openrc - run on host instead as cronjob. See logrotate.sh
RUN apk update && apk upgrade && apk add  --no-cache tzdata logrotate

RUN rm -v /etc/nginx/nginx.conf
RUN rm /etc/nginx/conf.d/*
COPY nginx.conf /etc/nginx/
COPY xnat.conf /etc/nginx/conf.d/
COPY nginx /etc/logrotate.d/
RUN chmod -R 600 /etc/nginx/
RUN chmod 600 /etc/logrotate.d/*


EXPOSE 444
EXPOSE 443
EXPOSE 80
EXPOSE 8082