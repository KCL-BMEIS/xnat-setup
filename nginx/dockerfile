FROM nginx:stable-alpine
ARG TIMEZONE
#takes timezone from host in build.sh

# needed for apk
USER root
RUN apk add --no-cache tzdata
ENV TZ=$TIMEZONE

RUN apk update && apk upgrade && apk add logrotate
RUN rm -v /etc/nginx/nginx.conf
RUN rm /etc/nginx/conf.d/*
COPY nginx.conf /etc/nginx/
COPY xnat.conf /etc/nginx/conf.d/
COPY nginx /etc/logrotate.d/
RUN chmod -R 775 /etc/nginx/


EXPOSE 444
EXPOSE 443
EXPOSE 80
EXPOSE 8082