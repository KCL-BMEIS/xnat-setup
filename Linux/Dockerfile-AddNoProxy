# If your XNAT is configured to run behind a proxy, but you need to add a server for XSync that is not, use this to modify existing xnat image
# Run:
# docker build --buikd-arg REMOTE_URL= ...   --build-arg LOCAL_URL=... --build-arg XNAT_IMAGE="$XNAT_VERSION"  -f Dockerfile-AddNoProxy -t XNAT_IMAGE" .
# example:
# docker build  --buikd-arg REMOTE_URL= ...   --build-arg LOCAL_URL=... --build-arg XNAT_IMAGE=xnat:1.10.0  -f Dockerfile-AddNoProxy  -t xnat:1.10.0 .
# You can change the output image, then edit docker-compose.yml to use it, for example -t xnat:1.10.0proxy
# Run sudo ./restart.sh


ARG XNAT_IMAGE=xnat:1.10.0
FROM $XNAT_IMAGE



ARG REMOTE_URL
ARG LOCAL_URL

ENV REMOTE=$REMOTE_URL
ENV LOCAL=$LOCAL_URL

ENV NO_PROXY=localhost,${LOCAL},127.0.0.1,xnat-web,${REMOTE}
ENV no_proxy=localhost,${LOCAL},127.0.0.1,xnat-web,${REMOTE}
RUN sed -i "s#|xnat-web#|xnat-web|${REMOTE}|#g" /usr/local/tomcat/bin/setenv.sh

